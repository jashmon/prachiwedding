# Optional durable RSVP storage. Create a table named `rsvps` using supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TICKETS_BUCKET=travel-tickets

# Required in Vercel: deploy the Apps Script as a web app that runs as you.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# Used for absolute metadata URLs in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
