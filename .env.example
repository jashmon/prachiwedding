# Optional durable RSVP storage. Create a table named `rsvps` using supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TICKETS_BUCKET=travel-tickets

# Required in Vercel: a Google service account that has Editor access to the Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:Z

# Optional, self-hosted PaddleOCR endpoint. It accepts the ticket only on the
# server and returns extracted text plus date/time suggestions.
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=

# Used for absolute metadata URLs in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
